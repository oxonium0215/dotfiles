# ╭─────────────────────────────────────────────────────────────────────────────────╮
# │ Component-specific rules                                                        │
# ╰─────────────────────────────────────────────────────────────────────────────────╯

# Ignore AtCoder tools config if not selected
{{- if not (index . "install_atcoder_tools" | default false) }}
.atcodertools.toml
my_template.cpp
{{- end }}

# Ignore textlint config, MCP server config, and install script if not selected
{{- if not (index . "install_textlint" | default true) }}
.textlintrc.json
.claude/.mcp.json
run_once_after_40-install-textlint.sh
{{- end }}

# Ignore LaTeX config if not selected
{{- if not (index . "install_tex" | default false) }}
.latexmkrc
{{- end }}

# ╭─────────────────────────────────────────────────────────────────────────────────╮
# │ Platform-specific rules                                                        │
# ╰─────────────────────────────────────────────────────────────────────────────────╯

# Linux/macOS: PowerShellプロファイルとAppDataは不要
{{- if ne .chezmoi.os "windows" }}
Documents
Documents/PowerShell
Documents/PowerShell/**
AppData
AppData/**
{{- end }}

# Windows: nvim設定、PowerShellプロファイル、AppData/Local/nvimを適用
{{- if eq .chezmoi.os "windows" }}
*
run_*.sh
run_*.sh.tmpl
!.gitconfig
!.config
!.config/nvim
!.config/nvim/**
!Documents
!Documents/PowerShell
!Documents/PowerShell/**
!AppData
!AppData/Local
!AppData/Local/nvim
!AppData/Local/nvim/**
!run_*.ps1
!run_*.ps1.tmpl
{{- end }}
