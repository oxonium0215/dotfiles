{{- if eq .chezmoi.os "windows" -}}
# Setup mise and install tools on Windows
# This script runs automatically whenever the mise config changes
# config.toml.tmpl hash: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}
# variables hash: {{ (print .install_tex .install_typst .install_web_dev .install_python .install_go .install_rust_tools .install_neovim_env .install_atcoder_tools) | sha256sum }}

$ErrorActionPreference = "Continue"

Write-Host "==> Setting up mise and installing tools on Windows..."

# Locate mise binary
$miseCmd = Get-Command mise -ErrorAction SilentlyContinue
if (-not $miseCmd) {
    $possiblePaths = @(
        "$env:LOCALAPPDATA\mise\bin\mise.exe",
        "$HOME\.local\bin\mise.exe",
        "$env:LOCALAPPDATA\Programs\mise\bin\mise.exe"
    )
    foreach ($p in $possiblePaths) {
        if (Test-Path $p) {
            $miseBinDir = [System.IO.Path]::GetDirectoryName($p)
            $env:PATH = "$miseBinDir;$env:PATH"
            $miseCmd = Get-Command mise -ErrorAction SilentlyContinue
            break
        }
    }
}

if (-not $miseCmd) {
    Write-Warning "mise is not installed or not found in PATH. Skipping tool installation."
    exit 0
}

# Trust the mise config
Write-Host "Trusting mise configurations..."
& mise trust --all

# Install all tools defined in the global config
Write-Host "Installing tools via mise (this may take a while)..."
& mise install

# Reshim to ensure all shims are up to date
& mise reshim

# Verify key tools are installed
Write-Host "Verifying tool installation..."
& mise list

Write-Host "==> mise setup completed successfully on Windows."
{{- end }}
