#!/bin/bash
# Install textlint and Japanese rule presets using bun
# This script runs once after chezmoi applies the dotfiles

set -euo pipefail

{{ if not (index . "install_textlint" | default true) -}}
echo "==> textlint: skipped (install_textlint = false)"
exit 0
{{ end -}}

echo "==> Installing textlint and rule presets with bun..."

# Check if bun is available
if ! command -v bun &>/dev/null; then
    echo "Warning: bun not found. Please install bun first (https://bun.sh)."
    echo "Textlint packages will NOT be installed."
    exit 1
fi

# Tier 1: Core presets (always install)
echo "  -> Installing Tier 1 presets..."
bun install -g textlint@latest
bun install -g textlint-rule-preset-ja-technical-writing@latest
bun install -g @textlint-ja/textlint-rule-preset-ai-writing@latest

# Tier 2: Complementary presets
{{ if index . "install_textlint_extras" | default false -}}
echo "  -> Installing Tier 2 presets..."
bun install -g textlint-rule-preset-jtf-style@latest
bun install -g textlint-rule-preset-ja-spacing@latest
bun install -g @textlint-ja/textlint-rule-no-synonyms@latest
{{ else -}}
echo "  -> Tier 2 presets skipped (set install_textlint_extras=true to enable)"
{{ end -}}

echo "==> textlint installation complete."

# Verify installation
if command -v textlint &>/dev/null; then
    echo "    textlint version: $(textlint --version)"
else
    echo "    Warning: textlint command not found after installation."
fi
