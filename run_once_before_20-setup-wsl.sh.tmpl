#!/bin/bash
# WSL-specific setup
# This script runs once before chezmoi applies the dotfiles (only on WSL)

{{- $isWSL := false -}}
{{- if hasKey .chezmoi "kernel" -}}
{{-   if hasKey .chezmoi.kernel "osrelease" -}}
{{-     $isWSL = contains "microsoft" (lower .chezmoi.kernel.osrelease) -}}
{{-   end -}}
{{- end -}}
{{ if and (eq .chezmoi.os "linux") $isWSL }}
set -euo pipefail

echo "==> Setting up WSL-specific configurations..."

# Install npiperelay for SSH Agent forwarding from Windows
# This allows using Bitwarden SSH Agent from WSL
NPIPERELAY_VERSION="v0.1.0"
NPIPERELAY_DIR="$HOME/.local/bin"

if ! command -v npiperelay.exe &>/dev/null; then
    echo "Installing npiperelay for SSH Agent forwarding..."

    if ! command -v curl &>/dev/null || ! command -v unzip &>/dev/null; then
        echo "Warning: curl or unzip is not installed. Skipping npiperelay installation."
    else
        mkdir -p "$NPIPERELAY_DIR"

        # Download npiperelay
        TEMP_DIR=$(mktemp -d)
        curl -fsSL "https://github.com/jstarks/npiperelay/releases/download/${NPIPERELAY_VERSION}/npiperelay_windows_amd64.zip" -o "$TEMP_DIR/npiperelay.zip"

        # Extract and install
        unzip -q "$TEMP_DIR/npiperelay.zip" -d "$TEMP_DIR"
        mv "$TEMP_DIR/npiperelay.exe" "$NPIPERELAY_DIR/"
        chmod +x "$NPIPERELAY_DIR/npiperelay.exe"

        rm -rf "$TEMP_DIR"
        echo "npiperelay installed to $NPIPERELAY_DIR/npiperelay.exe"
    fi
fi

# Install win32yank for clipboard integration between WSL and Windows
WIN32YANK_VERSION="v0.1.1"
WIN32YANK_DIR="$HOME/.local/bin"

if ! command -v win32yank.exe &>/dev/null; then
    echo "Installing win32yank for WSL clipboard integration..."

    if ! command -v curl &>/dev/null || ! command -v unzip &>/dev/null; then
        echo "Warning: curl or unzip is not installed. Skipping win32yank installation."
    else
        mkdir -p "$WIN32YANK_DIR"

        # Download win32yank
        TEMP_DIR=$(mktemp -d)
        curl -fsSL "https://github.com/equalsraf/win32yank/releases/download/${WIN32YANK_VERSION}/win32yank-x64.zip" -o "$TEMP_DIR/win32yank.zip"

        # Extract and install
        unzip -q "$TEMP_DIR/win32yank.zip" -d "$TEMP_DIR"
        mv "$TEMP_DIR/win32yank.exe" "$WIN32YANK_DIR/"
        chmod +x "$WIN32YANK_DIR/win32yank.exe"

        rm -rf "$TEMP_DIR"
        echo "win32yank installed to $WIN32YANK_DIR/win32yank.exe"
    fi
fi

# Install SumatraPDF for LaTeX PDF viewing from WSL
# Only installed when tex support is enabled
_install_tex='{{ index . "install_tex" | default "false" }}'
if [[ "$_install_tex" == "true" ]]; then
SUMATRAPDF_DIR="$HOME/.local/bin"
SUMATRAPDF_FALLBACK_VERSION="3.6.1"

install_sumatrapdf() {
    if ! command -v curl &>/dev/null || ! command -v unzip &>/dev/null; then
        echo "Warning: curl or unzip is not installed. Skipping SumatraPDF installation."
        return 1
    fi

    # Detect latest SumatraPDF version from the download page
    echo "Detecting latest SumatraPDF version..."
    local latest_version
    latest_version=$(curl -fsSL "https://www.sumatrapdfreader.org/download-free-pdf-viewer" | \
        grep -oP 'SumatraPDF-\K[0-9]+\.[0-9]+(\.[0-9]+)?(?=-64\.zip)' | \
        sort -Vru | head -1)

    if [[ -z "$latest_version" ]]; then
        echo "Warning: Could not detect latest version, using fallback ${SUMATRAPDF_FALLBACK_VERSION}"
        latest_version="$SUMATRAPDF_FALLBACK_VERSION"
    fi

    echo "Latest SumatraPDF version: ${latest_version}"

    mkdir -p "$SUMATRAPDF_DIR"

    # Download SumatraPDF portable version
    local temp_dir
    temp_dir=$(mktemp -d)
    curl -fsSL "https://www.sumatrapdfreader.org/dl/rel/${latest_version}/SumatraPDF-${latest_version}-64.zip" \
        -o "$temp_dir/SumatraPDF.zip"

    # Extract and install (glob matches any version in the zip)
    unzip -q "$temp_dir/SumatraPDF.zip" -d "$temp_dir"
    local exe_file
    exe_file=$(ls "$temp_dir"/SumatraPDF-*.exe 2>/dev/null | head -1)
    if [[ -z "$exe_file" ]]; then
        echo "Warning: Could not find SumatraPDF executable in the downloaded zip."
        rm -rf "$temp_dir"
        return 1
    fi

    mv "$exe_file" "$SUMATRAPDF_DIR/SumatraPDF.exe"
    chmod +x "$SUMATRAPDF_DIR/SumatraPDF.exe"
    rm -rf "$temp_dir"
    echo "SumatraPDF installed to $SUMATRAPDF_DIR/SumatraPDF.exe"
}

if ! command -v SumatraPDF.exe &>/dev/null; then
    echo "Installing SumatraPDF for LaTeX PDF viewer..."
    install_sumatrapdf
else
    echo "SumatraPDF.exe already installed, skipping."
fi
fi  # install_tex

# Ensure socat is installed (required for SSH Agent forwarding)
if ! command -v socat &>/dev/null; then
    echo "Warning: socat is not installed. SSH Agent forwarding will not work."
    echo "Please install socat: sudo apt-get install socat"
fi

echo "==> WSL setup completed."

{{ else -}}
# Not WSL, skip this script
exit 0
{{ end -}}